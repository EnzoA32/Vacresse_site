---
import Base from '../../layouts/Base.astro';
import PlayerCard from '../../components/PlayerCard.astro';
import { teams, events, club, fmt } from '../../lib/data.js';
export function getStaticPaths() { return teams.map((t) => ({ params: { slug: t.slug }, props: { t } })); }
const { t } = Astro.props;
const now = Date.now();
const mine = events.filter((e) => e.team === t.slug);
const next = mine.filter((e) => new Date(e.date).getTime() >= now && e.status !== 'Annulé').sort((a, b) => a.date.localeCompare(b.date));
const done = mine.filter((e) => e.score).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 5);
const rbfa = t.rbfa || club.rbfa;
const STAFF = ['Entraîneur', 'Adjoint', 'Délégué', 'Staff'];
const staff = t.players.filter((p) => STAFF.includes(p.position));
const joueurs = t.players.filter((p) => !STAFF.includes(p.position));
---
<Base title={t.name} description={`${t.name} : entraînements, prochain match et effectif.`}>
<div class="wrap">
<p class="muted"><a href="/equipes">← Toutes les équipes</a></p>
<div class="sh in"><small>Saison {club.season}</small><h1>{t.name}</h1></div>
{t.staff && <p class="muted">{t.staff}</p>}
<div class="ftabs" role="tablist"><button type="button" class="on" data-t="entrainements">Entraînements</button><button type="button" data-t="matchs">Matchs</button><button type="button" data-t="effectif">Effectif</button></div>
<section class="tp" id="entrainements">{t.trainings.length ? t.trainings.map((x) => <div class="card tr"><b>{x.day}</b><span>{x.time}</span><span class="muted">{x.place}</span></div>) : <p class="muted">Horaires à communiquer.</p>}</section>
<section class="tp" id="matchs" hidden>
<h2>Prochain match</h2>
{next[0] ? <div class="card nm"><span class="lbl">{next[0].status}</span><h3>{next[0].title}</h3><p>{fmt(next[0].date)}{next[0].place && ` · ${next[0].place}`}</p></div> : <p class="muted">Prochain match à confirmer.</p>}
{next.length > 1 && <>{next.slice(1, 4).map((e) => <div class="card"><b>{e.title}</b><br><span class="muted">{fmt(e.date)}</span></div>)}</>}
{done.length > 0 && <><h2>Derniers résultats</h2>{done.map((e) => <div class="card"><b>{e.title}</b> <span class="lbl">{e.score}</span></div>)}</>}
<p><a class="btn" href={rbfa} target="_blank" rel="noopener">Voir le classement officiel sur RBFA</a></p><p><a class="tl" href="/matchs">Voir tous les matchs du club →</a></p>
</section>
<section class="tp" id="effectif" hidden>
{staff.length > 0 && <><h2 class="eh">Staff</h2><div class="plist2">{staff.map((p) => <PlayerCard p={p} />)}</div></>}
{joueurs.length > 0 && <><h2 class="eh">Joueurs</h2><div class="plist2">{joueurs.map((p) => <PlayerCard p={p} />)}</div></>}
{!t.players.length && <p class="muted">Effectif à venir.</p>}
</section>
</div>
<script is:inline>
const bs=[...document.querySelectorAll('.ftabs button')],ps=[...document.querySelectorAll('.tp')];
const go=n=>{bs.forEach(b=>b.classList.toggle('on',b.dataset.t===n));ps.forEach(p=>p.hidden=p.id!==n)};
bs.forEach(b=>b.onclick=()=>{go(b.dataset.t);history.replaceState(null,'','#'+b.dataset.t)});
const h=location.hash.slice(1);if(['entrainements','matchs','effectif'].includes(h))go(h);
</script>
</Base>
